# ============================================================================
# allure-demo（咪咕票务上线验证回归）—— 哪些东西不进版本库
#
# 原则：
#   1) 凭据、登录态、票据 —— 一律不入库（这是本文件存在的首要理由）
#   2) 可重新生成的运行产物 —— 不入库（Allure 结果、报告、缓存）
#   3) 体积大、只是"某次快照"的中间数据 —— 不入库（逐场次座位回读 dump）
#   4) 环境事实与配置 —— **必须入库**：catalog.json 白名单、swagger 快照、
#      _prod_build_registry.json、tools/probe 下的构建脚本
# ============================================================================

# ---------- 1) 凭据 / 登录态 / 票据（绝不入库）----------
# .migu_state/<env>/ 下是 hmcer.json / b_cookies.json / passport_cookies.json / b_session.json
.migu_state/
# 存活测试的本地登录态配置（模板 live_config.example.json 入库）
live_config.json
live_testing/live_config.json

# ---------- 2) 运行产物 ----------
allure-results/
allure-report/
reports/
artifacts/history/
artifacts/live/
# artifacts 下的 json 是"上一次跑"的现场（含带签名的支付链接、订单号），
# 每跑一次就变 → 不入库，避免工作区一直 dirty、也避免外泄支付链接
artifacts/*.json
.pytest_cache/
__pycache__/
*.py[cod]
.venv/

# ---------- 3) 大体积一次性快照（要复现就重跑 tools/probe 导出）----------
tools/probe/_seat_prod_*.json
tools/probe/_resolve_prod.json
# 注意：tools/probe/_seat_222959.json 是"源结构样本"，**保留入库**

# ---------- 4) 本地备份 / 临时文件 ----------
.ref/
*.bak
*.bak.*
*.local.json
tmp/
.tmp/

# casegen 采数缓存（inventory 每次实测的快照，随时可重生成）
tools/casegen/.cache/

# ---------- 5) 编辑器与系统 ----------
.idea/
.vscode/
.DS_Store
.playwright/
.playwright-cli/
